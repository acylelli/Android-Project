<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_payment_panel"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="좌석 결제"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPaymentPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPaymentSeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider" />

    <RadioGroup
        android:id="@+id/rgPaymentPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbPass1Hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/jari_green"
            android:checked="true"
            android:text="1시간 이용권 · 2,000원"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbPass2Hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/jari_green"
            android:text="2시간 이용권 · 4,000원"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbPass3Hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/jari_green"
            android:text="3시간 이용권 · 6,000원"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="결제수단"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_payment_method"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="간편카드"
            android:textColor="@color/jari_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="총 결제금액"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaymentAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2,000원"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="결제 후 선택한 좌석이 바로 배정됩니다."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPaymentCancel"
            android:layout_width="88dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="취소"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPaymentConfirm"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="결제하기"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
